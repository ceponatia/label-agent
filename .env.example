# Label Agent secrets. Copy to .env (never committed) and fill in.
# These are read after config.toml and override it.

# Gmail account the agent reads. Use the full address.
LABELAGENT_IMAP_USER=elaineamy.g2010@gmail.com

# Google *app password* (16 chars, spaces optional) — not the account password.
# Requires 2-Step Verification on the Google account.
LABELAGENT_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# Anthropic API key for the email classifier and crop verifier.
ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides of config.toml -------------------------------------
# CUPS printer name; empty or "file" uses the FilePrinter fake.
# LABELAGENT_PRINTER=Canon_TS9521
# LABELAGENT_PRINT_MEDIA=na_index-4x6_4x6in
# LABELAGENT_PRINT_MEDIA_SOURCE=rear
# LABELAGENT_AUTO_PRINT=true

# LABELAGENT_DATA_DIR=data
# LABELAGENT_DB_PATH=data/labelagent.db
# LABELAGENT_LABEL_RETENTION_DAYS=90

# LABELAGENT_POLL_INTERVAL_MIN=3
# LABELAGENT_IMAP_HOST=imap.gmail.com
# LABELAGENT_IMAP_FOLDER=INBOX
# LABELAGENT_POSHMARK_SENDER_DOMAIN=poshmark.com
# LABELAGENT_VINTED_SENDER_DOMAIN=vinted.com

# LABELAGENT_WEB_HOST=0.0.0.0
# LABELAGENT_WEB_PORT=8080

# LABELAGENT_CLASSIFIER_MODEL=claude-haiku-4-5
