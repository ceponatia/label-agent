# systemd unit for the future home server.
#
#   sudo cp deploy/systemd/label-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now label-agent
#   journalctl -u label-agent -f
#
# Edit User, WorkingDirectory and ExecStart to match the install path. Secrets
# stay in <WorkingDirectory>/.env, which the service reads on startup.

[Unit]
Description=Label Agent - prints Poshmark/Vinted shipping labels
Documentation=file:/opt/label-agent/README.md
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=labelagent
Group=labelagent
WorkingDirectory=/opt/label-agent
ExecStart=/opt/label-agent/.venv/bin/python -m labelagent serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

# The service only ever writes inside its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/label-agent/data

[Install]
WantedBy=multi-user.target
